# Claude runs on your Claude subscription through Claude Code (shared/claude.py).
# Locally your Claude Code login is enough. For GitHub, make a token with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: CLAUDE_BACKEND=api bills the Anthropic API per token instead.
ANTHROPIC_API_KEY=
GMAIL_CREDENTIALS_JSON={"installed":{"client_id":"...","client_secret":"...","redirect_uris":["urn:ietf:wg:oauth:2.0:oob"]}}
GMAIL_TOKEN_JSON={"token":"...","refresh_token":"...","token_uri":"...","client_id":"...","client_secret":"...","scopes":["https://www.googleapis.com/auth/gmail.send"]}
# Old Gmail notifier (orchestrator.py) sends to and from this address.
NOTIFY_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram webhook (api/telegram.py on Vercel). Any long random string; the same value
# goes in Vercel's env vars. `python scripts/set_telegram_webhook.py --new-secret` makes one.
TELEGRAM_WEBHOOK_SECRET=
# Fine-grained GitHub token, liams-agents repo only, "Actions: read and write".
# Lets the webhook start the Writer workflow when Liam taps Apply. Lives in Vercel.
GITHUB_DISPATCH_TOKEN=
