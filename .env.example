# Claude runs on your Claude subscription through Claude Code (shared/claude.py).
# Locally your Claude Code login is enough. For GitHub, make a token with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: CLAUDE_BACKEND=api bills the Anthropic API per token instead.
ANTHROPIC_API_KEY=
GMAIL_CREDENTIALS_JSON={"installed":{"client_id":"...","client_secret":"...","redirect_uris":["urn:ietf:wg:oauth:2.0:oob"]}}
GMAIL_TOKEN_JSON={"token":"...","refresh_token":"...","token_uri":"...","client_id":"...","client_secret":"...","scopes":["https://www.googleapis.com/auth/gmail.send"]}
